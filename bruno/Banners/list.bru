meta {
  name: List banners
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/banners
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has data", function() {
    expect(res.getBody()).to.have.property("data");
  });

  test("data is an array", function() {
    expect(res.getBody().data).to.be.an("array");
  });
}